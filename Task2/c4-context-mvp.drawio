        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Диаграмма контекста C4&lt;/b&gt;&lt;br&gt;MVP «Медикаменте»: запись на приём через портал" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="520" height="40" as="geometry" />
        </mxCell>

        <!-- People -->
        <mxCell id="patient" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Клиент медицинского центра,&#xa;который записывается на приём&#xa;через личный кабинет" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="120" height="140" as="geometry" />
        </mxCell>

        <mxCell id="reception" value="&lt;b&gt;Сотрудник ресепшена&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Принимает звонки, подтверждает&#xa;записи и отправляет напоминания" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="140" height="140" as="geometry" />
        </mxCell>

        <mxCell id="doctor" value="&lt;b&gt;Медицинский специалист&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Получает расписание и&#xa;напоминания о приёмах" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="150" height="140" as="geometry" />
        </mxCell>

        <!-- Software Systems -->
        <mxCell id="patient-portal" value="&lt;b&gt;Портал пациента&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Веб-приложение для записи&#xa;на приём и управления&#xa;личными данными пациента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA9;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="reception-portal" value="&lt;b&gt;Портал ресепшена&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Интерфейс для управления&#xa;записями, пациентами&#xa;и напоминаниями" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA9;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="appointment-service" value="&lt;b&gt;Сервис записи на приём&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Управляет расписанием,&#xa;слотами и заявками&#xa;на приём к специалистам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA9;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="crm" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Единая система учёта&#xa;пациентов, контактов&#xa;и договоров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA9;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="360" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="notification-service" value="&lt;b&gt;Сервис уведомлений&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Отправляет email/SMS/push&#xa;о записях и напоминаниях" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5CA9;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
