        <mxCell id="iam" value="&lt;b&gt;IAM / Keycloak + AD&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Аутентификация и&#xa;управление доступом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
